// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InterstitialConfig {
  id                String   @id @default(cuid())
  enabled           Boolean  @default(true)
  countdownDuration Int      @default(5)
  autoDownload      Boolean  @default(true)
  popupTitle        String   @default("Support free downloads")
  popupDescription  String   @default("Your download will start automatically...")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AdPlacement {
  id          String   @id @default(cuid())
  name        String   @default("Untitled Ad")
  template    String   @default("medium_rectangle")
  enabled     Boolean  @default(true)
  type        String   @default("display")
  placement   String   @default("interstitial_popup")
  position    String   @default("center")
  dimensions  String   @default("300x250")
  adCode      String   @default("")
  description String   @default("")
  priority    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([placement, enabled])     // Most common ad query pattern
}

model DownloadLog {
  id            String   @id @default(cuid())
  videoId       String?
  videoTitle    String?
  provider      String?
  platform      String   @default("tiktok")
  success       Boolean  @default(false)
  responseTime  Int?
  error         String?
  /// PRIVACY: Must be SHA-256 hash. NEVER store raw IPs (GDPR).
  ipAddress     String?
  requestId     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])              // Date-range queries & analytics
  @@index([createdAt, success])     // Compound for success-rate analytics
  @@index([provider])              // Grouping/filtering by provider
}

model Analytics {
  id             String   @id @default(cuid())
  date           DateTime @unique
  totalDownloads Int      @default(0)
  successCount   Int      @default(0)
  failCount      Int      @default(0)
  avgResponseMs  Int      @default(0)
  uniqueVisitors Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ProviderStatus {
  id            String   @id @default(cuid())
  name          String   @unique
  platform      String   @default("tiktok")
  active        Boolean  @default(true)
  successRate   Float    @default(0.0)
  avgResponseMs Int      @default(0)
  lastCheck     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Settings {
  id        String @id @default(cuid())
  key       String @unique
  value     String
  updatedAt DateTime @updatedAt
}
