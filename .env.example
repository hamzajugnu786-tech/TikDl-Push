# ============================================================
# TikDL Environment Variables — Production Security Audit
# ============================================================
#
# SECURITY RULES:
# - NEVER use NEXT_PUBLIC_ prefix for secrets
# - NEXT_PUBLIC_ vars are embedded in client JavaScript (visible in DevTools)
# - Server-only vars (no NEXT_PUBLIC_) stay on the server
#
# CHANGES FROM PREVIOUS .env.example:
# - NEXT_PUBLIC_ADMIN_PASSWORD → ADMIN_PASSWORD (server-side only)
#   Password is NEVER exposed to browser JavaScript anymore
# - NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY removed
#   Supabase is not used in the current codebase (dead config)
# ============================================================

# Database — Turso (libSQL) for Vercel serverless
# Production: use Turso remote connection
DATABASE_URL="libsql://tikdl-db-xxx.turso.io"
DATABASE_AUTH_TOKEN=""
# Local development: uncomment below to use local SQLite instead
# DATABASE_URL="file:./dev.db"

# ============================================================
# SECRETS — Server-side only, NEVER expose to browser
# ============================================================

# Admin authentication password (server-side only)
# REQUIRED in production. In development, defaults to 'admin123' for convenience.
# ⚠️  NEVER use NEXT_PUBLIC_ADMIN_PASSWORD — that exposes the password to browser JS
ADMIN_PASSWORD="admin123"

# Provider API keys (server-side only)
TIKHUB_API_KEY=""
RAPIDAPI_KEY=""

# ============================================================
# CONFIGURATION — Server-side only
# ============================================================

# Default provider name (tikhub = primary, rapidapi = fallback)
PROVIDER_NAME="tikhub"

# ============================================================
# PUBLIC SITE URL — Public by design (NOT a secret)
# ============================================================
# Canonical production site URL. Used as the source of truth for:
#   - sitemap.xml URLs
#   - homepage JSON-LD WebApplication.url
#   - per-page alternates.canonical and openGraph.url
#   - layout metadataBase / alternates.canonical fallback
#   - admin Settings default `siteUrl` value
# Source of truth: src/lib/site-config.ts
#
# To change the production domain in the future:
#   1. Configure the new domain in Vercel (Project Settings → Domains).
#   2. Set NEXT_PUBLIC_SITE_URL in Vercel Project Environment Variables.
#   3. Redeploy. No code change required.
#
# This variable is PUBLIC by design — it is embedded in SEO metadata,
# JSON-LD, sitemap.xml, and OpenGraph tags that crawlers MUST see.
# NEVER put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SITE_URL="https://tikdl.leadforgeai.site"

# ============================================================
# GOOGLE ANALYTICS 4 — Measurement ID (PUBLIC, not a secret)
# ============================================================
# GA4 Measurement ID, format: G-XXXXXXXXXX (e.g. G-1A2B3C4D5E)
#
# This value is PUBLIC by design — it appears in the page HTML of every
# GA4-enabled website and is visible in browser DevTools. It grants NO
# administrative access to your GA4 property; it only identifies which
# property should receive event data.
#
# - When unset or empty: the GA4 component (src/components/analytics/GA4.tsx)
#   renders nothing and analytics helpers in src/lib/analytics.ts no-op.
#   The site continues to work normally — downloads, form submission, and
#   all other functionality remain unaffected.
# - When set: the gtag.js loader is injected via next/script with
#   strategy="afterInteractive" (async, non-render-blocking).
#
# HOW TO OBTAIN A MEASUREMENT ID:
#   1. Sign in to https://analytics.google.com/ with a Google account.
#   2. Admin → Create Property → choose "Web" → enter site URL
#      (https://tikdl.leadforgeai.site) → accept defaults.
#   3. Open the new property → Admin → Data Streams → click the web stream.
#   4. The Measurement ID (G-XXXXXXXXXX) is shown at the top right.
#   5. In Vercel: Project Settings → Environment Variables → add
#      NEXT_PUBLIC_GA_MEASUREMENT_ID with the Measurement ID value.
#      Apply to Production (and Preview if desired). Skip Development.
#   6. Trigger a redeploy (push to main, or click Redeploy).
#
# NEVER confuse the Measurement ID with:
#   - GA4 API keys / service-account JSON keys (server-side only)
#   - Google Cloud OAuth client secrets (server-side only)
#   - Google Search Console verification tokens (different concept)
#
# PRIVACY NOTE:
#   Once a real Measurement ID is set, GA4 will collect pageview + conversion
#   events. The privacy policy at /privacy has been updated to mention GA4
#   cookies. TikDL does NOT send TikTok URLs, video IDs, usernames, or any
#   raw user input to GA4 — only aggregate event parameters
#   (download_type, download_result, platform). See src/lib/analytics.ts.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ============================================================
# OPTIONAL — Future integration, not currently used
# ============================================================

# If Supabase is integrated in the future, use server-side keys only:
# SUPABASE_URL=""        (server-side, no NEXT_PUBLIC_)
# SUPABASE_SERVICE_KEY="" (server-side, for admin operations)
# SUPABASE_ANON_KEY=""   (server-side, for read-only public access)
