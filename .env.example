# ============================================================
# TikDL Environment Variables — Production Security Audit
# ============================================================
#
# SECURITY RULES:
# - NEVER use NEXT_PUBLIC_ prefix for secrets
# - NEXT_PUBLIC_ vars are embedded in client JavaScript (visible in DevTools)
# - Server-only vars (no NEXT_PUBLIC_) stay on the server
#
# CHANGES FROM PREVIOUS .env.example:
# - NEXT_PUBLIC_ADMIN_PASSWORD → ADMIN_PASSWORD (server-side only)
#   Password is NEVER exposed to browser JavaScript anymore
# - NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY removed
#   Supabase is not used in the current codebase (dead config)
# ============================================================

# Database — Turso (libSQL) for Vercel serverless
# Production: use Turso remote connection
DATABASE_URL="libsql://tikdl-db-xxx.turso.io"
DATABASE_AUTH_TOKEN=""
# Local development: uncomment below to use local SQLite instead
# DATABASE_URL="file:./dev.db"

# ============================================================
# SECRETS — Server-side only, NEVER expose to browser
# ============================================================

# Admin authentication password (server-side only)
# REQUIRED in production. In development, defaults to 'admin123' for convenience.
# ⚠️  NEVER use NEXT_PUBLIC_ADMIN_PASSWORD — that exposes the password to browser JS
ADMIN_PASSWORD="admin123"

# Provider API keys (server-side only)
TIKHUB_API_KEY=""
RAPIDAPI_KEY=""

# ============================================================
# CONFIGURATION — Server-side only
# ============================================================

# Default provider name (tikhub = primary, rapidapi = fallback)
PROVIDER_NAME="tikhub"

# ============================================================
# OPTIONAL — Future integration, not currently used
# ============================================================

# If Supabase is integrated in the future, use server-side keys only:
# SUPABASE_URL=""        (server-side, no NEXT_PUBLIC_)
# SUPABASE_SERVICE_KEY="" (server-side, for admin operations)
# SUPABASE_ANON_KEY=""   (server-side, for read-only public access)
